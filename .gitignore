.DS_Store
.env
.env.*
!.env.example
.venv/
__pycache__/
*.py[cod]
*.log

# Local-only generated scratch files.
.pytest_cache/
.mypy_cache/

# Keep dashboard JSON committed for GitHub Pages, but do not commit ad-hoc local archives.
*.tmp
*.bak

# Per-symbol chart files: generated at build time by build_dashboard_data.py and
# shipped in the Pages artifact (upload-pages-artifact uploads dashboard/), but
# NOT committed — all ~344 change daily, which would bloat git history.
dashboard/charts/

# Tickertape universe cache (~1.8MB, refreshed every couple days). Cheap to
# rebuild (~12 bulk requests); the enriched values are baked into
# dashboard_data.json, so no need to commit this.
reports/tickertape_fundamentals_cache.json

# Upstox instrument-master cache (downloaded daily by upstox_sync). The useful
# output — dashboard/upstox_data.json — IS committed; this raw master is not.
reports/upstox_cache/
