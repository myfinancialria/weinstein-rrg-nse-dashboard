FYERS_CLIENT_ID=your_fyers_client_id
FYERS_ACCESS_TOKEN=your_fyers_access_token

# Optional pre-open input for the daily Market Blog tab.
# Use a manual value when a stable public GIFT Nifty feed is unavailable.
GIFT_NIFTY_LEVEL=

# Optional Yahoo Finance symbol if you have a working GIFT Nifty proxy.
GIFT_NIFTY_SYMBOL=

# --- Upstox API (upstox_sync: fundamentals + options + FII/DII) ---
# Runs on the VM (not GitHub Actions — Upstox has no headless login). App creds
# come from https://account.upstox.com/developer/apps; the token expires ~03:30 IST.
#
# ONE-PLACE TOKEN (recommended on the VM): if another job on the same VM already
# refreshes an Upstox token (e.g. the paper-trader / stock360 .env), just point at
# that file and leave everything else blank — its UPSTOX_* (app creds + fresh token)
# are read automatically, so you never run `login` for this repo:
#   UPSTOX_ENV_FILE=/home/ubuntu/nifty-paper-trader/.env
UPSTOX_ENV_FILE=

# OR set these directly (only needed if NOT using UPSTOX_ENV_FILE above).
# Token is then filled by `python -m upstox_sync login <redirect-url>`.
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_API_SECRET=your_upstox_api_secret
UPSTOX_REDIRECT_URI=https://127.0.0.1:5000/callback
UPSTOX_TOKEN=

# Optional: screener.in PREMIUM session cookie, used to scrape product/business
# segment revenue for the drawer's "Revenue by Segment" pie chart. Log in to a
# screener.in premium account and copy the `sessionid` cookie (or the full
# cookie string). Without it, segment numbers stay empty and the drawer shows a
# graceful "not disclosed" note. Segment values are premium-gated at the source.
SCREENER_SESSION_COOKIE=
